diff --git a/autokeysupply/css/aks.css b/autokeysupply/css/aks.css
new file mode 100644
index 0000000..2deca1a
--- /dev/null
+++ b/autokeysupply/css/aks.css
@@ -0,0 +1,874 @@
+:root {
+  --ink: #0b1220;
+  --ink-soft: #1a2436;
+  --steel: #5b6b7c;
+  --line: #d7dee7;
+  --paper: #f3f6f9;
+  --surface: #ffffff;
+  --accent: #1e8fd5;
+  --accent-deep: #0c5f96;
+  --accent-soft: #e7f4fc;
+  --ok: #0f766e;
+  --warn: #b45309;
+  --danger: #b91c1c;
+  --shadow: 0 18px 50px rgba(11, 18, 32, .08);
+  --radius: 16px;
+  --font: "Figtree", system-ui, sans-serif;
+  --display: "Barlow Condensed", "Arial Narrow", sans-serif;
+  --max: 1120px;
+  --ease: cubic-bezier(.22, 1, .36, 1);
+}
+
+*, *::before, *::after { box-sizing: border-box; }
+html { scroll-behavior: smooth; }
+body {
+  margin: 0;
+  font-family: var(--font);
+  color: var(--ink);
+  background:
+    radial-gradient(1200px 500px at 10% -10%, rgba(30, 143, 213, .16), transparent 60%),
+    radial-gradient(900px 420px at 100% 0%, rgba(15, 118, 110, .08), transparent 55%),
+    linear-gradient(180deg, #eef3f8 0%, var(--paper) 38%, #e9eef4 100%);
+  line-height: 1.55;
+  min-height: 100vh;
+  -webkit-font-smoothing: antialiased;
+}
+img { max-width: 100%; display: block; }
+a { color: inherit; text-decoration: none; }
+button, input, select, textarea { font: inherit; }
+.container { width: min(var(--max), calc(100% - 2rem)); margin: 0 auto; }
+
+.poc-banner {
+  background: linear-gradient(90deg, #0b1220, #12324a 55%, #0c5f96);
+  color: #dceaf5;
+  font-size: .78rem;
+  letter-spacing: .04em;
+  text-align: center;
+  padding: .55rem 1rem;
+}
+.poc-banner strong { color: #fff; font-weight: 700; }
+
+.site-header {
+  position: sticky;
+  top: 0;
+  z-index: 40;
+  backdrop-filter: blur(14px);
+  background: rgba(243, 246, 249, .88);
+  border-bottom: 1px solid rgba(215, 222, 231, .9);
+}
+.header-inner {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+  min-height: 72px;
+}
+.brand {
+  display: inline-flex;
+  align-items: center;
+  gap: .75rem;
+  min-width: 0;
+}
+.brand img {
+  height: 34px;
+  width: auto;
+  object-fit: contain;
+}
+.brand-meta {
+  display: flex;
+  flex-direction: column;
+  gap: .1rem;
+  line-height: 1.1;
+}
+.brand-name {
+  font-family: var(--display);
+  font-size: 1.35rem;
+  font-weight: 700;
+  letter-spacing: .02em;
+  text-transform: uppercase;
+}
+.brand-badge {
+  font-size: .65rem;
+  font-weight: 700;
+  letter-spacing: .14em;
+  text-transform: uppercase;
+  color: var(--accent-deep);
+}
+.nav {
+  display: flex;
+  align-items: center;
+  gap: 1.1rem;
+}
+.nav a {
+  font-size: .82rem;
+  font-weight: 600;
+  color: var(--steel);
+  letter-spacing: .02em;
+  transition: color .2s;
+}
+.nav a:hover, .nav a.is-active { color: var(--ink); }
+.header-actions {
+  display: flex;
+  align-items: center;
+  gap: .65rem;
+}
+.lang-switch {
+  display: inline-flex;
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  overflow: hidden;
+  background: var(--surface);
+}
+.lang-switch button {
+  border: 0;
+  background: transparent;
+  padding: .35rem .6rem;
+  font-size: .7rem;
+  font-weight: 700;
+  letter-spacing: .08em;
+  color: var(--steel);
+  cursor: pointer;
+}
+.lang-switch button.is-on {
+  background: var(--ink);
+  color: #fff;
+}
+.menu-btn {
+  display: none;
+  border: 1px solid var(--line);
+  background: var(--surface);
+  border-radius: 10px;
+  width: 42px;
+  height: 42px;
+  cursor: pointer;
+}
+.cart-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: .35rem;
+  border: 1px solid var(--line);
+  background: var(--surface);
+  border-radius: 999px;
+  padding: .4rem .75rem;
+  font-size: .78rem;
+  font-weight: 700;
+}
+
+.btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: .4rem;
+  border-radius: 12px;
+  padding: .75rem 1.1rem;
+  font-weight: 700;
+  font-size: .9rem;
+  border: 1px solid transparent;
+  cursor: pointer;
+  transition: transform .2s var(--ease), box-shadow .2s var(--ease), background .2s;
+}
+.btn:hover { transform: translateY(-1px); }
+.btn-primary {
+  background: linear-gradient(135deg, var(--accent), var(--accent-deep));
+  color: #fff;
+  box-shadow: 0 10px 24px rgba(12, 95, 150, .28);
+}
+.btn-dark {
+  background: var(--ink);
+  color: #fff;
+}
+.btn-outline {
+  background: transparent;
+  border-color: var(--line);
+  color: var(--ink);
+}
+.btn-ghost {
+  background: var(--accent-soft);
+  color: var(--accent-deep);
+}
+.btn-sm { padding: .45rem .75rem; font-size: .78rem; border-radius: 10px; }
+.btn-block { width: 100%; }
+
+.hero {
+  position: relative;
+  overflow: hidden;
+  padding: 2.5rem 0 2rem;
+}
+.hero-panel {
+  display: grid;
+  grid-template-columns: 1.15fr .85fr;
+  gap: 1.5rem;
+  align-items: stretch;
+}
+.hero-copy {
+  padding: 1.5rem 0;
+  animation: rise .7s var(--ease) both;
+}
+.eyebrow {
+  display: inline-flex;
+  align-items: center;
+  gap: .5rem;
+  font-size: .72rem;
+  font-weight: 700;
+  letter-spacing: .16em;
+  text-transform: uppercase;
+  color: var(--accent-deep);
+  margin: 0 0 .9rem;
+}
+.hero h1 {
+  margin: 0;
+  font-family: var(--display);
+  font-size: clamp(2.4rem, 6vw, 4.2rem);
+  line-height: .95;
+  letter-spacing: .01em;
+  text-transform: uppercase;
+  max-width: 12ch;
+}
+.hero-lead {
+  margin: 1rem 0 1.4rem;
+  color: var(--steel);
+  font-size: 1.05rem;
+  max-width: 38ch;
+}
+.hero-actions { display: flex; flex-wrap: wrap; gap: .7rem; }
+.hero-visual {
+  position: relative;
+  min-height: 320px;
+  border-radius: 28px;
+  overflow: hidden;
+  background:
+    linear-gradient(145deg, rgba(30,143,213,.35), rgba(11,18,32,.92)),
+    radial-gradient(circle at 30% 30%, rgba(255,255,255,.18), transparent 45%),
+    #0b1220;
+  box-shadow: var(--shadow);
+  animation: fadeIn 1s var(--ease) both;
+}
+.hero-visual::after {
+  content: "";
+  position: absolute;
+  inset: auto -10% -20% 20%;
+  height: 70%;
+  background: radial-gradient(circle, rgba(30,143,213,.45), transparent 65%);
+  filter: blur(20px);
+}
+.hero-key {
+  position: absolute;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  color: #e8f4fc;
+  z-index: 1;
+}
+.hero-key svg { width: min(70%, 280px); height: auto; opacity: .92; }
+.hero-stat {
+  position: absolute;
+  left: 1rem;
+  bottom: 1rem;
+  z-index: 2;
+  background: rgba(255,255,255,.1);
+  border: 1px solid rgba(255,255,255,.18);
